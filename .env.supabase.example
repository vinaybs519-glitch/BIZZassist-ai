PORT=3000
HOST=127.0.0.1
DATABASE_PROVIDER=supabase
# Obtain the Session pooler URL from the Supabase project's Connect dialog.
# Replace [YOUR-PASSWORD] with the URL-encoded database password locally.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:5432/postgres
SUPABASE_SSL_CA_PATH=
DEMO_MODE=false
AI_PROVIDER=offline
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Set true when you serve the app through HTTPS.
COOKIE_SECURE=false
