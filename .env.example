PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/bizassist.db
# sqlite (local) or supabase (PostgreSQL)
DATABASE_PROVIDER=sqlite
# Copy the PostgreSQL session-pooler connection string from Supabase > Connect.
# This is a database password URL, NOT an API URL or API key. Keep it server-only.
SUPABASE_DB_URL=
# Optional: path to Supabase's downloaded root certificate. TLS is always verified.
SUPABASE_SSL_CA_PATH=
# Seed sample accounts and tickets on first start only. Disable for real deployments.
DEMO_MODE=true
# offline or openai-compatible
AI_PROVIDER=offline
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Enable behind HTTPS in production
COOKIE_SECURE=false
